{
  "name": "aegis-defai-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Aegis DeFAI Agent Backend — OpenRouter LLM + WebSocket + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:fork": "vitest run --config vitest.integration.config.js mainnet-fork",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ethers": "^6.17.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-fetch": "^3.3.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
