# ===== Aegis DeFAI Backend Environment Variables =====

# [REQUIRED] OpenRouter API Key for LLM access
OPENROUTER_API_KEY=""

# [OPTIONAL] EVM Private Key for executing transactions.
# Testnet only by default — onchain mode refuses chainId 1 (mainnet) unless
# ALLOW_MAINNET_LIVE=true is explicitly set.
EVM_PRIVATE_KEY=""

# [REQUIRED for onchain] RPC URL for the target network (Sepolia, Arbitrum, ...)
EVM_PROVIDER_URL=""

# [OPTIONAL] Target chain id when execution.mode="onchain"
# (default: aegis.config.js execution.chainId = 11155111)
# Set EVM_CHAIN_ID=1 to point the agent at mainnet — verify on a fork first!
# EVM_CHAIN_ID="11155111"

# [REQUIRED] 32-BYTE encryption key for securing database entries
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (32 bytes = 64 hex chars. A 16-byte key is silently padded and weakens AES-256.)
ENCRYPTION_KEY=""

# [OPTIONAL] Rest API bearer auth. When set, every /api request must send:
#   Authorization: Bearer <AEGIS_API_KEY>
AEGIS_API_KEY=""

# [OPTIONAL] WebSocket subprotocol auth key. When unset a hardcoded default is
# used — set this in production.
WS_API_KEY=""

# [OPTIONAL] Allowed CORS origins (comma separated). Defaults to localhost dev.
CORS_ORIGINS="http://localhost:5173"

# [OPTIONAL] Port / log level
# PORT="3001"
# LOG_LEVEL="info"

# [OPTIONAL] OpenTelemetry tracing folded into /metrics (docs/OBSERVABILITY.md).
# When false (default) trace() calls are zero-overhead no-ops.
# OTEL_ENABLED="true"

# [OPTIONAL] Execution backend override: 'simulation' (default) | 'onchain'
# EXECUTION_MODE="simulation"

# [OPTIONAL] Mainnet fork verification (docs/MAINNET_FORK.md). Fork-only key has
# no real value; used only against the local anvil fork.
# MAINNET_FORK_URL="http://127.0.0.1:8545"
# MAINNET_FORK_PRIVATE_KEY=""

# [DANGER] Explicit opt-in to run onchain execution against REAL mainnet.
# Do not set until mainnet fork verification (npm run test:fork) has passed.
# ALLOW_MAINNET_LIVE="true"

# [OPTIONAL] Notifications (Phase 4 / C7). Leave unset to disable all external
# channels — the agent then logs alerts to winston + WS only. At least one
# channel configured (or both) to receive alert/error/critical events.
# Telegram bot (@BotFather token) + chat id (private chat with your bot):
# NOTIFY_TELEGRAM_TOKEN=""
# NOTIFY_TELEGRAM_CHAT_ID=""
# SMTP email (implicit TLS on 465, or STARTTLS on 587 when SECURE=false):
# NOTIFY_EMAIL_HOST=""
# NOTIFY_EMAIL_PORT="465"
# NOTIFY_EMAIL_SECURE="true"
# NOTIFY_EMAIL_USER=""
# NOTIFY_EMAIL_PASS=""
# NOTIFY_EMAIL_FROM=""
# NOTIFY_EMAIL_TO=""
